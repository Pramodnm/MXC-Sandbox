# ==============================================================================
# MXC Sandbox & Microsoft Agent Framework (MAF) Configuration
# Copy this file to .env and configure your endpoint and credentials.
# ==============================================================================

# OmniRouter or OpenAI-Compatible AI Gateway Endpoint
OMNIROUTER_BASE_URL=http://localhost:20128/v1
OMNIROUTER_API_KEY=sk-your-omnirouter-or-openai-api-key-here

# Default AI Model (e.g. Gemini 3.7 Flash, GPT-4o, Claude 3.5 Sonnet)
SPECIALIST_MODEL=l-s-Poc/gemini-3.7-flash

# Standard Fallback Aliases
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=sk-your-omnirouter-or-openai-api-key-here
OPENAI_MODEL=l-s-Poc/gemini-3.7-flash
